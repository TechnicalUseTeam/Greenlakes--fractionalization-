rules_version = '2';

// Green Lakes estate photos. Public read so the site and app can render
// them; writes are admin-only (custom claim role admin/super_admin/operations).
// Console: Storage > Rules > paste > Publish. CLI deploy needs a privileged
// login, so prefer the console while the app uses its own key.
service firebase.storage {
  match /b/{bucket}/o {
    match /estate-photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.role in ['admin', 'super_admin', 'operations'];
    }
  }
}
